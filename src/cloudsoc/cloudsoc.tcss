Screen {
    background: rgb(6, 7, 8);
    color: rgb(221, 221, 221);
}

Header,
Footer {
    background: rgb(18, 20, 22);
    color: rgb(220, 220, 220);
}

Static {
    background: rgb(12, 14, 16);
    color: rgb(220, 220, 220);
}

Horizontal {
    height: 1fr;
}

#left {
    width: 30%;
    border: solid rgb(80, 110, 130);
    padding: 1;
    background: rgb(10, 12, 14);
}

#right {
    width: 70%;
    border: solid rgb(80, 110, 130);
    padding: 1;
    background: rgb(10, 12, 14);
}

#logs {
    height: 8;
    border: solid rgb(90, 90, 90);
    padding: 1;
    background: rgb(8, 10, 12);
}

#cloud {
    background: rgb(10, 12, 14);
}
